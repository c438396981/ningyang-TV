services:
  libretv:
    image: bestzwei/libretv:latest
    container_name: libretv
    environment:
      - PASSWORD=${PASSWORD:-c1234}
      - ADMINPASSWORD=${ADMINPASSWORD:-c1234}
      - MAX_RETRIES=0
    restart: unless-stopped
    volumes:
      - ./index.html:/app/index.html:ro
      - ./player.html:/app/player.html:ro
      - ./robots.txt:/app/robots.txt:ro
      - ./sitemap.xml:/app/sitemap.xml:ro
      - ./googleafe2f4b946db9f80.html:/app/googleafe2f4b946db9f80.html:ro
      - ./password.js:/app/js/password.js:ro
      - ./server.mjs:/app/server.mjs:ro
    networks:
      - libretv-net

networks:
  libretv-net:
    external: true
EOFcd /opt/LibreTV

cp docker-compose.yml docker-compose.yml.bak

